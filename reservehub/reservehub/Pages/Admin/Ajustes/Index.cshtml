@page
@model reservehub.Pages.Admin.Ajustes.IndexModel
@{
    ViewData["Title"] = "Ajustes del Sistema";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-gear-fill text-primary me-2"></i>Ajustes Generales</h2>
            <p class="text-muted small mb-0">Configuración general de parámetros del sistema ReserveHub.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Formulario de Configuración -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-sliders me-2"></i>Parámetros de la Plataforma</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Nombre del Sistema</label>
                            <input type="text" asp-for="NombreSistema" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Correo Electrónico de Soporte / Notificaciones</label>
                            <input type="email" asp-for="CorreoSoporte" class="form-control" />
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input type="checkbox" asp-for="ModoMantenimiento" class="form-check-input" id="mantenimientoCheck" />
                            <label class="form-check-label fw-bold small text-secondary" for="mantenimientoCheck">Activar Modo Mantenimiento</label>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary fw-bold px-4">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Información del Servidor -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle me-2"></i>Estado del Servidor</h5>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">Versión .NET:</span>
                            <span class="fw-bold">.NET 8.0</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">Base de Datos:</span>
                            <span class="fw-bold text-success">SQL Server (Online)</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">Motor ORM:</span>
                            <span class="fw-bold">Entity Framework Core</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Seguridad:</span>
                            <span class="fw-bold text-primary">Cookies & Sesión</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>