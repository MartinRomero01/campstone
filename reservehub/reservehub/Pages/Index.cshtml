@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio - ReserveHub";
}

<div class="container my-5">
    <!-- Hero Section / Presentación Principal -->
    <div class="row align-items-center mb-5 pb-4 border-bottom">
        <div class="col-lg-7">
            <span class="badge bg-primary text-white mb-2 px-3 py-2 rounded-pill fw-bold">Sistema Integral de Gestión</span>
            <h1 class="display-4 fw-bold text-dark mb-3">Bienvenido a <span class="text-primary">ReserveHub</span></h1>
            <p class="lead text-secondary mb-4">
                Plataforma avanzada desarrollada en .NET 8 para la gestión centralizada de reservas presenciales, solicitudes en línea, aranceles y servicios académicos institucionales.
            </p>
            <div class="d-flex gap-3">
                <a href="/Login/Index" class="btn btn-primary btn-lg shadow-sm fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                </a>
                <a href="#caracteristicas" class="btn btn-outline-secondary btn-lg fw-bold">Conocer más</a>
            </div>
        </div>
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <div class="card bg-light border-0 shadow-sm p-4">
                <div class="card-body">
                    <i class="bi bi-calendar-check text-primary display-1 mb-3 d-block"></i>
                    <h4 class="fw-bold">Gestión Eficiente</h4>
                    <p class="text-muted small mb-0">Control total de turnos, solicitudes y comunicación institucional en tiempo real bajo un entorno seguro.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Características Principales -->
    <div id="caracteristicas" class="row g-4 py-3">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-3 d-inline-block mb-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Atención Presencial y Online</h5>
                    <p class="text-muted small mb-0">Administra reservas de turnos presenciales y seguimiento detallado de solicitudes en línea con soporte multi-rol.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-3 d-inline-block mb-3">
                        <i class="bi bi-journal-bookmark-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Carreras y Aranceles</h5>
                    <p class="text-muted small mb-0">Módulos especializados para la administración centralizada del catálogo académico, carreras y aranceles institucionales.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-3 d-inline-block mb-3">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Seguridad y Control</h5>
                    <p class="text-muted small mb-0">Autenticación robusta basada en cookies, control de sesiones activas y gestión de accesos diferenciados por roles (Admin/User).</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Créditos y Presentación Institucional -->
    <div class="card bg-dark text-white border-0 shadow-sm mt-5 p-4 rounded-4">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-2"><i class="bi bi-code-slash text-info me-2"></i>Presentación del Proyecto & Créditos</h5>
                    <p class="text-white-50 small mb-0">
                        <strong>ReserveHub</strong> es un sistema de software optimizado y estructurado bajo arquitectura web moderna con ASP.NET Core .NET 8 y SQL Server, diseñado para la eficiencia en procesos de atención y control académico.
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="badge bg-secondary text-light px-3 py-2">Versión 1.0 - Producción</span>
                </div>
            </div>
        </div>
    </div>
</div>