@page
@model reservehub.Pages.Login.IndexModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center fw-bold text-primary mb-1">ReserveHub</h3>
                <p class="text-center text-muted small mb-4">Ingresa tus datos para acceder al sistema</p>

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        @Model.MensajeError
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Correo Electrónico</label>
                        <input type="email" asp-for="Email" class="form-control" placeholder="admin@reservehub.cl" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contraseña</label>
                        <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>